{
    "name": "demo/streamable-http-mcp-server",
    "description": "A standards-compatible Streamable HTTP MCP server demo with SSE, built with Hyperf 3.2 and PHP 8.5",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-swoole": "*",
        "hyperf/command": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/di": "~3.2.0",
        "hyperf/engine": "^2.10",
        "hyperf/framework": "~3.2.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/logger": "~3.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {},
        "audit": {
            "block-insecure": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/hyperf.php start"
        ],
        "test": "@php tests/protocol_test.php"
    }
}
